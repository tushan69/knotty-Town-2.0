# Copy to ".env" for Vite (local) and configure the same keys in your hosting panel for PHP.

# --- MySQL (required in production for api/*.php) ---
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

# --- Vite / frontend (build-time) ---
# Google AI (Gemini) for AIConcierge + DripVision. Use ONE of these (same key value is fine):
GEMINI_API_KEY=
# VITE_GEMINI_API_KEY=
# Restart `npm run dev` after changes. For production, set the same var in the host/CI before `npm run build`.
VITE_RAZORPAY_KEY_ID=
VITE_GOOGLE_CLIENT_ID=

# --- PHP admin & CORS (set in hosting environment for production) ---
ADMIN_USER=
ADMIN_PASS=
ADMIN_TOKEN=
# Optional: lock API browser origin, e.g. https://yourdomain.com
CORS_ALLOW_ORIGIN=
